# Salin jadi .env.setup lalu isi. File .env.setup TIDAK ikut ter-commit (aman untuk token).
# AI membaca file ini saat menjalankan docs/setup-ai.md.

# dokploy = jalan di VPS lewat Dokploy (dipakai di kelas)
# local   = jalan di laptop/desktop (Docker Desktop)
SETUP_MODE=dokploy

# Akun pertama di aplikasi (otomatis jadi admin)
ADMIN_NAME=Nama Anda
ADMIN_EMAIL=email@anda.com
ADMIN_PASSWORD=

# ---------------- Khusus SETUP_MODE=dokploy ----------------
# URL panel Dokploy, mis. https://dokploy.domainanda.com atau http://IP-VPS:3000
DOKPLOY_URL=
# Dokploy -> Settings -> Profile -> API/CLI -> Generate
DOKPLOY_API_KEY=
# Subdomain aplikasi, mis. ctwa.domainanda.com.
# Buat manual di Cloudflare: A record -> IP VPS, Proxy aktif (awan oranye), SSL/TLS mode Full.
APP_DOMAIN=
# Repo yang di-deploy. Default repo kelas (public). Repo private butuh deploy key (lihat docs/setup-ai.md)
GIT_REPO_URL=https://github.com/vatih/ctwa-tracker.git
GIT_BRANCH=stable
